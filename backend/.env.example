DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gymmy
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Origins allowed to call the API directly from a browser (comma separated).
# The bundled frontend proxies /api/v1 through Next.js, so it doesn't need this.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra allowed origins as a regex. Default: any port on localhost/127.0.0.1/[::1].
# Set it empty in production:  CORS_ORIGIN_REGEX=
# CORS_ORIGIN_REGEX=
# "View demo" on the login page: private sandbox gyms with sample data
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=200
